<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Flags reflection-based JSON at build time. Set here, not via a global -p:, which would analyse Yaeger too. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      Version="10.0.*"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Firewall.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\Yaeger\src\Engine\Yaeger.Browser\Yaeger.Browser.csproj" />
    <ProjectReference Include="..\Firewall.Rules\Firewall.Rules.csproj" />
  </ItemGroup>
</Project>
