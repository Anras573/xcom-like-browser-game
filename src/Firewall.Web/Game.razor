@inject NavigationManager Nav
@inject HttpClient Http
@using System.Numerics
@using Firewall.Web.Assets
@using Yaeger.Browser
@using Yaeger.Platform
@implements IDisposable

<canvas id="yaeger-canvas"></canvas>

@code {
    private BrowserRenderSurface? _surface;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Base-relative, so GitHub Pages sub-paths work.
        await YaegerBrowser.InitializeAsync(Nav.BaseUri);

        var registry = await AssetRegistry.LoadAsync(Http);

        _surface = new BrowserRenderSurface("yaeger-canvas")
        {
            ClearColor = new Vector4(0.07f, 0.08f, 0.1f, 1f),
        };
        _surface.Initialize();

        await BrowserTextRenderSurface.LoadFontAsync(DebugSheetScene.FontFamily, DebugSheetScene.FontUrl);

        // tiles.png has no spacing between tiles, so Linear bleeds neighbours at fractional
        // camera positions. Must be set before the texture loads (see tools/README.md).
        _surface.SetSampling("assets/tiles.png", TextureSampling.Pixelated);

        // Preload so quads never show as white placeholders.
        await _surface.PreloadAsync(registry.TexturePaths, new Progress<float>());

        var app = new GameApp(_surface, registry);
        YaegerBrowser.StartGameLoop(app.Tick);
    }

    public void Dispose()
    {
        YaegerBrowser.StopGameLoop();
        _surface?.Dispose();
    }
}
