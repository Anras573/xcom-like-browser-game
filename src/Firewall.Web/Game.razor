@inject NavigationManager Nav
@inject HttpClient Http
@using System.Numerics
@using Firewall.Web.Rendering
@using Yaeger.Browser
@using Yaeger.Platform
@implements IDisposable

<canvas id="yaeger-canvas"></canvas>

@code {
    private BrowserRenderSurface? _surface;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Base-relative, so GitHub Pages sub-paths work.
        await YaegerBrowser.InitializeAsync(Nav.BaseUri);

        _surface = new BrowserRenderSurface("yaeger-canvas")
        {
            ClearColor = new Vector4(0.07f, 0.08f, 0.1f, 1f),
        };
        _surface.Initialize();

        // Fonts, manifests, textures and game data load inside the boot scene, behind a progress bar.
        var app = new GameApp(_surface, Http);
        YaegerBrowser.StartGameLoop(app.Tick);
    }

    public void Dispose()
    {
        YaegerBrowser.StopGameLoop();
        _surface?.Dispose();
    }
}
